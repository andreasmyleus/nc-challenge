    "@grpc/grpc-js": "^1.9.16",
    "protobufjs": "^8.4.1",
    "proxy-addr": "^2.0.8",
    "websocket-driver": "^0.7.5",
    "lodash": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "jws": "^4.0.1",
    "semver": "^7.5.2",
